{
  "appId": "com.eva.kiosk",
  "appName": "EVA Monitor Kiosk",
  "webDir": "app-bootstrap",
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": true
  },
  "plugins": {
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0F172A"
    },
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#0F172A",
      "showSpinner": false
    },
    "Keyboard": {
      "resize": "body"
    }
  }
}
